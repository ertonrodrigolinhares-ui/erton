# A janela do Jarvis cria este arquivo sozinha quando você cola a chave.
# Nunca envie o arquivo .env para ninguém.
GEMINI_API_KEY=sua-chave-do-gemini
JARVIS_USUARIO=Erton
# gemini (gratuito) ou claude (pago)
JARVIS_IA=gemini
JARVIS_GEMINI_MODELO=gemini-flash-latest
# Só para JARVIS_IA=claude:
# ANTHROPIC_API_KEY=sua-chave-da-anthropic
# JARVIS_CLAUDE_MODELO=claude-opus-5
